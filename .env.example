# Copy to .env.local and fill in. Never commit .env.local.

# AI: fixture (default, no key needed) | replit | anthropic | gemini
AI_PROVIDER=fixture
# Model ID. Confirm the current Claude Sonnet ID at docs.claude.com before setting.
FORGE_MODEL=
# Server only. Optional; used when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Server only. Used when AI_PROVIDER=gemini.
GEMINI_API_KEY=
# Tried first; on a 429 the fallback is tried automatically (separate quota).
GEMINI_MODEL_PRIMARY=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
# Optional: stop making live calls after this many (counted in logs/ai-calls.jsonl).
AI_CALL_BUDGET=
# Optional: set to 1 to save each live response into data/fixtures/.
RECORD_FIXTURES=

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Public key, browser sign-in only. Cannot read any table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated email:space_id pairs for the staff allow-list.
STAFF_SEED=

# Sign-in: "google" (default, real USC Google sign-in through Supabase) or "test".
# In test mode a picker signs you in as a test student, test staff or a non-USC
# account, and a "Test sign-in" banner shows on every page. Never use in production.
AUTH_MODE=google
