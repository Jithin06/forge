  "services": [
    {
      "name": "3D print work order",
      "how_to_request": "Open to all USC students, with no training. Submit the request form. Student workers print it and answer your questions. You pay for material only, at pickup, with a USC ID card or USC account.",
      "url": "https://docs.google.com/forms/u/2/d/e/1FAIpQLSdLfjsy2pTRdiKEvDxOGvLgcNSF4Lf05G-Mg_li9BCrzRpjbQ/viewform",
      "equipment_ids": [
        "prusa_mk4",
        "stratasys_f900",
        "stratasys_f370",
        "form_3l",
        "markforged_x7",
        "prusa_pro_ht90"
      ],
      "steps": [
        "Submit the 3D print work order form with your file.",
        "Student workers email you an estimate to approve, then print it. Ask them anything you are unsure about.",
        "You are emailed when it is ready. Collect it and pay for the material only, with a USC ID card or USC account."
      ],
      "open_to_all": true
    }
  ],
  "usage_fee_note": "The Maker Space sells no material: bring your own. Material on hand is for Maker Space members' use and is never sold. The only charge is for 3D prints made by work order, by the material used; the chart lists higher prices for non-Viterbi students, and only for the Prusa printers.",
  "prohibited": [],
  "scrap_policy": {
    "offers_scrap": true,
    "never_offer": [
      "resin",
      "unknown_plastic"
    ],
    "pickup_note": "Show this claim to a staff member at the Maker Space. They will hand the piece to you.",
    "terms": "Free, for student use only. Pickup is in person, with a staff member present.",
    "may_post": [
      "Failed or leftover PLA and PETG prints",
      "Filament ends and partial spools",
      "Offcuts of plywood, fiberboard, acrylic and cardboard",
      "Wood offcuts",
      "Metal offcuts with no sharp edges",
      "Wire ends and loose fasteners"
    ],
    "never_post": [
      "Resin prints, resin bottles or trays",
      "Batteries",
      "Adhesives, paints, solvents and lubricants",
      "Solder and flux",
      "Dust, shavings and sanding waste",
      "Carbon-fibre or fibreglass pieces",
      "Blades, bits and broken tooling",
      "Any material nobody can identify",
      "Tools and equipment"
    ],
    "block_unidentified": true
  },
