/**
 * Writes RESULTS.md from what the scripts measured. Every number in the
 * file is produced here or read from another script's saved output; nothing
 * is typed in by hand. Sections with nothing measured say so.
 *   npm run results
 */
import { execFileSync } from "node:child_process";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import { createClient } from "@supabase/supabase-js";

const db = createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!, { auth: { persistSession: false } });
const out: string[] = [];
const now = new Date().toLocaleString("en-US", { timeZone: "America/Los_Angeles", dateStyle: "medium", timeStyle: "short" });
out.push("# Results", "", `Generated by \`npm run results\` on ${now} PT. Every number below was produced by a script in \`scripts/\`. Nothing here is estimated or typed in by hand.`, "");

// ---- unit tests
const tests = execFileSync("npm", ["test"], { encoding: "utf8" });
const t = /Tests\s+(\d+) passed \((\d+)\)/.exec(tests);
const f = /Test Files\s+(\d+) passed \((\d+)\)/.exec(tests);
out.push("## Automated tests", "", t && f ? `- ${t[1]} of ${t[2]} unit tests pass, in ${f[1]} of ${f[2]} files (\`npm test\`).` : "- Could not read the test summary.", "- The ten cases of SPEC section 6.5 are in `src/lib/section-6-5.test.ts`. They run against sample and mocked model replies and prove what the code guarantees.", "");

// ---- race test
out.push("## Race test (5 users claim one item at the same instant)", "");
try {
  const race = execFileSync("npm", ["run", "-s", "race"], { encoding: "utf8" }).trim();
  out.push("```", race, "```", "");
} catch (e) {
  out.push("```", String((e as { stdout?: string }).stdout ?? e), "```", "");
}

// ---- eval
out.push("## Eval (top route in the accepted set)", "");
if (existsSync("reports/eval-latest.json")) {
  const e = JSON.parse(readFileSync("reports/eval-latest.json", "utf8"));
  out.push(
    `- Cases: ${e.cases}. Status of the cases: **${e.cases_status}**.`,
    `- Top route in the accepted set: **${e.top_in_accepted} of ${e.cases}**.`,
    `- Badges correct: **${e.badges_correct} of ${e.badges_total}**.`,
    `- Cases that errored: ${e.errors}.`,
    `- Average model calls per plan: ${e.model_answers_per_plan ?? "not recorded"} (1 normally, 2 when the model is asked to look again).`,
    `- Rule checks on every plan (open work orders, no "Cheapest" on a general price, bring your own): ${e.rule_breaks?.length ? e.rule_breaks.join("; ") : "none broken"}.`,
    `- Run at ${e.ran_at} with a live model (\`npm run eval\`). Run once; prompts were not changed afterwards.`,
    "",
    "| Case | Student | Result | Top route | Accepted | Routes and badges | Calls |",
    "| --- | --- | --- | --- | --- | --- | --- |",
    ...(e.results as { id: string; audience?: string; top?: string | null; accepted?: string[]; top_ok?: boolean; routes?: string[]; model_answers?: number; error?: string }[]).map((r) =>
      r.error
        ? `| ${r.id} | | **Error** | ${r.error} | | | |`
        : `| ${r.id} | ${r.audience} | ${r.top_ok ? "Pass" : "**Fail**"} | ${r.top ?? "no route"} | ${r.accepted?.join(", ") || "no route"} | ${r.routes?.join("; ") || "none"} | ${r.model_answers ?? ""} |`,
    ),
    "",
  );
} else {
  const cases = JSON.parse(readFileSync("data/eval-cases.json", "utf8"));
  out.push(`**Not run.** ${cases.cases.length} cases are written (${cases.status}). The eval runs only on a live model, with \`npm run eval\`, after the cases are reviewed.`, "");
}

// ---- plan quality on a live model
out.push("## Plan quality on a live model", "");
if (existsSync("reports/plan-quality.json")) {
  const q = JSON.parse(readFileSync("reports/plan-quality.json", "utf8")) as { at: string; route_counts: Record<string, number>; calls?: { plans: number; model_answers_per_plan: number | null; plan_requests_sent: number; plan_requests_failed: number }; checks: { check: string; ok: boolean }[] };
  const passed = q.checks.filter((c) => c.ok).length;
  out.push(
    `- Last run of \`npm run check:quality\`: ${q.at}. ${passed} of ${q.checks.length} checks passed.`,
    `- Routes per idea: ${Object.entries(q.route_counts).map(([k, v]) => `${k} ${v}`).join(", ") || "no plan came back"}.`,
    ...(q.calls ? [`- Model calls per plan: ${q.calls.model_answers_per_plan} on average over ${q.calls.plans} plans (1 normally, 2 when the model is asked to look again). Plan requests sent in that run: ${q.calls.plan_requests_sent}, of which the provider failed ${q.calls.plan_requests_failed}.`] : []),
    ...q.checks.filter((c) => !c.ok).map((c) => `- Failed: ${c.check}.`),
    "- Enforced by code on every plan: ids exist and belong to the route's space; no dollar amounts; no two routes with the same space and equipment; a single route must carry a stated reason; the ways the model marks as offered must each become a route.",
    "- **Not enforced by code:** that steps and warnings do not tell the student how to operate a machine, and that they mention only equipment features found in the space data. These rest on the prompt and on the word-pattern check in `scripts/check-plan-quality.mts`, which reads live plans for the six example ideas. Nothing removes such a sentence from a plan a student sees.",
    "",
  );
} else {
  out.push("**Not run.** `npm run check:quality` needs a live model.", "");
}

// ---- live AI usage
out.push("## Live AI calls, tokens and cost per plan", "");
const logPath = process.env.AI_CALL_LOG || "logs/ai-calls.jsonl";
const calls = existsSync(logPath) ? readFileSync(logPath, "utf8").split("\n").filter(Boolean).map((l) => JSON.parse(l)) : [];
if (calls.length === 0) {
  out.push("**No live AI call has been made.** Tokens and cost per plan cannot be measured yet.", "");
} else {
  const ok = calls.filter((c) => c.status === 200);
  const plans = ok.filter((c) => c.call === "plan");
  const avg = (xs: number[]) => (xs.length ? Math.round(xs.reduce((a, b) => a + b, 0) / xs.length) : 0);
  out.push(
    `- Requests sent to a live model: ${calls.length} (${ok.length} answered, ${calls.filter((c) => c.status === 429).length} rate-limited, ${calls.filter((c) => c.status !== 200 && c.status !== 429).length} rejected or failed).`,
    `- By model: ${[...new Set(calls.map((c) => c.model))].map((m) => `${m}: ${calls.filter((c) => c.model === m).length}`).join("; ")}.`,
    plans.length
      ? `- Average tokens per plan call (${plans.length} calls): ${avg(plans.map((c) => c.input_tokens))} in, ${avg(plans.map((c) => c.output_tokens))} out.`
      : "- No plan calls yet.",
    "- Cost per plan in dollars: not computed. The calls ran on a free-tier key, and no price per token has been looked up.",
    "",
  );
}

// ---- scrap
const TEST_POSTERS = ["forge-test-staff@usc.edu", "check-m4", "race-test", "ui-review"];
const { data: items } = await db.from("scrap_items").select("status, posted_by");
const real = (items ?? []).filter((i) => !TEST_POSTERS.includes(i.posted_by));
const { data: impact } = await db.from("impact").select("items_picked_up").single();
out.push(
  "## Scrap items",
  "",
  `- Posted by real staff accounts: ${real.length}.`,
  `- Picked up (the impact counter, counted in SQL over all items): ${impact?.items_picked_up ?? 0}.`,
  `- Items from test accounts or check scripts currently in the database: ${(items ?? []).length - real.length}. They are excluded from the first line.`,
  "",
);

// ---- spaces
const { data: spaces } = await db.from("spaces").select("id, doc->>name, doc->status").order("id");
out.push("## Spaces listed", "", "| Space | Confirmed by staff | Still estimated |", "| --- | --- | --- |");
for (const s of spaces ?? []) {
  const groups = Object.entries(s.status as Record<string, { state: string }>);
  out.push(`| ${s.name} | ${groups.filter(([, g]) => g.state === "confirmed").map(([k]) => k).join(", ") || "none"} | ${groups.filter(([, g]) => g.state === "estimated").map(([k]) => k).join(", ") || "none"} |`);
}
out.push("");
writeFileSync("RESULTS.md", out.join("\n"));
console.log(out.join("\n"));
